# 复制为 .env 后填写实际值，至少替换所有 change-me 与 AES_KEY 占位
DB_ROOT_PASSWORD=change-me-root
DB_NAME=pophie
DB_USER=pophie_user
DB_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

# Base64-encoded 32-byte (256-bit) AES key.
# 生成命令：openssl rand -base64 32
# 下行为占位 (32 字节零)，禁止用于生产
AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 首次接入自动建表用 update；稳定后改回 validate
JPA_DDL_AUTO=update

# ---- macOS Docker 数据目录与端口（deploy/macos-deploy.sh 会自动补全）----
# 勿留空：为空时 compose 会回退到 ./.pophie-data，但推荐用绝对路径 ~/PophieData
DATA_ROOT=
HOST_PORT=9900
MYSQL_HOST_PORT=9902
REDIS_HOST_PORT=9903

# 业务密钥（也可写进 config.yaml）
LLM_API_KEY=sk-dc2ca02d0bdc47f18f2d5a78d92af321
DASHSCOPE_API_KEY=sk-ws-H.RXDPMDE.HgY5.MEQCIH-N1NxwfgFGRGTU3qQq-jh8B6x8PCwk_ieYJ5uSiXFSAiB-lf5sVfy-g-7Gvzq4IDqrFRqm4wetxgn53Ovjzv0ZpQ
ADMIN_TOKEN=

# ---- MQTT Broker (EMQX) ----
# 机器人通过MQTT接收唤醒通知，默认匿名连接即可
# Dashboard 默认账号：admin / public，生产环境请修改
MQTT_DASHBOARD_USER=admin
MQTT_DASHBOARD_PASSWORD=public
# 如果需要MQTT用户名/密码认证，取消注释并填写（EMQX默认允许匿名）
# MQTT_USERNAME=pophie
# MQTT_PASSWORD=change-me-mqtt-client

# ---- 端口映射（docker-compose.yml 通用；macOS 见上方 HOST_PORT）----
APP_HOST_PORT=9900
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
MQTT_HOST_PORT=1883
MQTT_WS_PORT=8083
MQTT_DASHBOARD_PORT=18083
