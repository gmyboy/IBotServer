<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBindDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="绑定设备" />

        <TextView
            android:id="@+id/deviceBindInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#616161"
            android:text="设备：未绑定" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="用户信息"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etUserNickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="昵称"
                android:inputType="textPersonName"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etUserGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="性别(male/female)"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etUserBirthday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="生日(YYYY-MM-DD)"
                android:inputType="date"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSaveUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="保存用户" />

            <Button
                android:id="@+id/btnLoadUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="读取" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUserInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#757575"
            android:text="用户信息：未加载" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="机器人配置"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRobotName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="机器人名称(display_name)"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etRobotPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="人设(persona)，如：我是一个友好的机器人伙伴"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <EditText
            android:id="@+id/etRobotGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="问候语(greeting)，如：你好呀，今天想聊什么？"
            android:inputType="textMultiLine"
            android:minLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveRobot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存机器人" />

            <Button
                android:id="@+id/btnLoadRobot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="读取配置" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRobotInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#757575"
            android:text="机器人配置：未加载" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="状态：未启动" />

        <TextView
            android:id="@+id/speaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:text="说话人：—" />

        <TextView
            android:id="@+id/meter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="输出字节：0" />

        <TextView
            android:id="@+id/enrollHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:background="#FFF3E0"
            android:textColor="#E65100"
            android:textSize="15sp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="停止" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEnroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="登记主人(8s)" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空声纹" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCohort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="录入背景人声/别人(2.5s)" />

        <TextView
            android:id="@+id/cohortInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="cohort：0（≥3 人可 AS-Norm，推荐 ≥8；无 cohort 时 cosine 自标定）" />

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自检相似度(2.5s)" />

        <TextView
            android:id="@+id/verifyResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="自检：—" />

        <Button
            android:id="@+id/btnMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="门控：REPORT（点击切 OWNER_ONLY）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="服务端（实时 STT + 可选对话）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="http://&lt;本机IP&gt;:8000  模拟器用 10.0.2.2:8000"
            android:inputType="textUri"
            android:singleLine="true"
            android:text="http://10.0.2.2:8000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRealtimeStt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="实时 STT（边说边识别，与主人无关）" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="段结束 chat/stream（对话回复）" />

            <Button
                android:id="@+id/btnTestReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="测试回复推送（reply/notify）" />

            <Button
                android:id="@+id/btnTestServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="测连接" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="服务：未检测" />

        <TextView
            android:id="@+id/sttResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:background="#E8F5E9"
            android:textColor="#1B5E20"
            android:textSize="14sp"
            android:text="STT：—" />

        <TextView
            android:id="@+id/replyResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:background="#E3F2FD"
            android:textColor="#0D47A1"
            android:textSize="14sp"
            android:text="回复：—" />

        <TextView
            android:id="@+id/timingInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:background="#FFF8E1"
            android:textColor="#E65100"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="⏱ 耗时：—" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="段日志：" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>
</ScrollView>
